// The device-level entry points the presenter and the handoff call, resolved by
// VulkanDevice::Wrap through vkGetDeviceProcAddr. The plain form is Vulkan 1.0
// core plus the swapchain and is required; the optional form is newer core or
// an extension, absent on some devices (the game's device A may be 1.1), and
// whoever needs one checks it (the presenter checks synchronization2, the
// timelines and sync files on device B). Hosts define
// ZEROFG_PORTABLE_DEVICE_FUNCTION_OPTIONAL too; it defaults to the plain form.
#ifndef ZEROFG_PORTABLE_DEVICE_FUNCTION_OPTIONAL
#define ZEROFG_PORTABLE_DEVICE_FUNCTION_OPTIONAL(name) \
  ZEROFG_PORTABLE_DEVICE_FUNCTION(name)
#define ZEROFG_PORTABLE_DEVICE_FUNCTION_OPTIONAL_DEFAULTED
#endif
