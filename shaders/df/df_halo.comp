#version 450
#extension GL_GOOGLE_include_directive : require
// df 1.2.1 (DF_PRODUCT_OPTS 512): the halo disguise's decision, one lane per 4 x 4 block of the picture, for the blocks of the tiles the cleanup
// lists (a flag in their tile's 3 x 3). It runs apart from the cleanup because a GPU wave pays for the decision whenever any of its lanes needs
// it: inside the cleanup that was nearly every wave of a fast pan, here every lane decides a block of its own. Writes vrs[3 i ..] = (v, applies)
// for block i (row-major, (W + 3) / 4 blocks a row); df_clean_t.comp fills the block's doubtful pixels along v.
// pc.a = (W, H, 0, 0), pc.b = (the flow's scale, the phase x 1000, 0, 0).
#include "df_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

const vec3 kY = vec3(0.299, 0.587, 0.114);

// 1.2.1 (DF_PRODUCT_OPTS 512, the lab's clean=7+mbs=2+mbg=1+mbt=2+mbc=1, 2026-11-24): the occlusion halo disguised as the background's own motion.
// The owner's instinct: going along one specific motion makes the fill consistent, and consistency fools the eye in motion (DLSS 4 shows the
// halo too: nobody has that information). The motion is ELECTED by 13 flow samples (here, 4 at 12 px, 8 at 24 px; the most samples within
// 2 px + 8 % of it, ties to the larger), the content comes along it from both Reals (A at x - t v, B at x + (1 - t) v, the nearer weighted more)
// over a line half the motion long (9 taps, at most 48 px), then is clamped to the 5 x 5 range already there (TAA's clamp: a wipe's black
// curtain cannot speck a flat sky). It acts only where the ring shows a halo's shape; anywhere else the box stays:
//   - a still layer: 2 samples under a quarter of the elected motion (the character the camera carries; Arkham's fast scenery has none);
//   - Zeromeia's curtain: the moving and the still samples (not the centre, where DIS fattened the edge) on opposite sides of one edge, 75 %
//     of each on its side, 4 moving and 2 still votes, and their relative motion across it (|(v - u) . n| >= max(3 px, 0.35 |v - u|));
//   - the elected motion carries texture: beyond the motion from the edge on the moving side, a 3 x 3 patch of A (2 px apart) matches B moved
//     by v better than B in place (cost < 0.7x); a patch without texture (sd <= 0.01) leaves the geometry's verdict (a dark street proves
//     nothing either way). Rayman's wipes (a curtain sliding over a still screen) fail here.
// The decision, once per 4 x 4 block (neighbours see nearly the same ring, and one vector per block keeps the fill coherent), at the
// block's pixel (1, 1): true and the elected motion v when the halo disguise applies.
bool halo_decide(ivec2 p, int W, int H, out vec2 v) {
  const int sc = max(1, pc.b.x);
  const float t = float(pc.b.y) * 0.001;
  vec2 cand[13];
  vec2 pos[13];
  cand[0] = full_flow_t(0, sc, float(p.x), float(p.y));
  pos[0] = vec2(0.0);
  for (int q = 0; q < 12; ++q) {
    float ang = q < 4 ? float(q) * 1.5707963 : float(q - 4) * 0.7853982 + 0.3926991;
    float rad = q < 4 ? 12.0 : 24.0;
    pos[q + 1] = rad * vec2(cos(ang), sin(ang));
    cand[q + 1] = full_flow_t(0, sc, float(p.x) + pos[q + 1].x, float(p.y) + pos[q + 1].y);
  }
  // An exact early out (most doubtful pixels of a fast pan leave here, before any vote): the elected motion is never longer than the longest
  // sample, so the still layer's 2 samples under a quarter of it must already be under a quarter of the longest, and the line needs 4 px.
  float lmax = 0.0;
  for (int q = 0; q < 13; ++q) lmax = max(lmax, length(cand[q]));
  float slow = 0.0;
  for (int q = 0; q < 13; ++q) slow += length(cand[q]) < 0.25 * lmax ? 1.0 : 0.0;
  if (lmax < 4.0 || slow < 2.0) return false;
  // The votes, once: each sample's count of samples within its own tolerance.
  float votes[13];
  v = cand[0];
  float best = -1.0;
  for (int q = 0; q < 13; ++q) {
    const float tq = 2.0 + 0.08 * length(cand[q]);
    float n = 0.0;
    for (int r = 0; r < 13; ++r) n += distance(cand[q], cand[r]) < tq ? 1.0 : 0.0;
    votes[q] = n;
    float score = n + 1e-3 * length(cand[q]);
    if (score > best) { best = score; v = cand[q]; }
  }
  if (floor(best) < 4.0) return false;
  const float lv = length(v), tol = 2.0 + 0.08 * lv;
  if (lv < 4.0) return false;
  float ns = 0.0;
  vec2 u = vec2(0.0);   // the still layer's representative: its best-voted sample
  for (int q = 0; q < 13; ++q) {
    if (distance(cand[q], v) < tol || length(cand[q]) >= 0.25 * lv) continue;
    if (votes[q] > ns) { ns = votes[q]; u = cand[q]; }
  }
  if (ns < 2.0) return false;
  vec2 cm = vec2(0.0), cs = vec2(0.0);
  float km = 0.0, ks = 0.0;
  int grp[13];
  for (int q = 1; q < 13; ++q) {
    float dm = distance(cand[q], v), ds = distance(cand[q], u);
    bool im = dm < tol, is = ds < 2.0 + 0.08 * length(u);
    grp[q] = im && (!is || dm <= ds) ? 1 : is ? 2 : 0;
    if (grp[q] == 1) { cm += pos[q]; km += 1.0; }
    if (grp[q] == 2) { cs += pos[q]; ks += 1.0; }
  }
  if (km < 4.0 || ks < 2.0) return false;
  cm /= km; cs /= ks;
  vec2 d = cm - cs;
  if (dot(d, d) <= 1.0) return false;
  vec2 nn = normalize(d), mid = 0.5 * (cm + cs);
  float om = 0.0, os = 0.0;
  for (int q = 1; q < 13; ++q) {
    float side = dot(pos[q] - mid, nn);
    if (grp[q] == 1 && side > 0.0) om += 1.0;
    if (grp[q] == 2 && side < 0.0) os += 1.0;
  }
  vec2 rel = v - u;
  if (om < 0.75 * km || os < 0.75 * ks || abs(dot(rel, nn)) < max(3.0, 0.35 * length(rel))) return false;
  {
    vec2 x0 = vec2(p) + cm + nn * min(lv, 48.0) - t * v;
    float cmv = 0.0, cst = 0.0, mu = 0.0, m2 = 0.0;
    for (int j = -1; j <= 1; ++j)
      for (int k = -1; k <= 1; ++k) {
        vec2 x = x0 + 2.0 * vec2(float(k), float(j));
        float la = dot(real_bil(0, x.x, x.y), kY);
        cmv += abs(la - dot(real_bil(1, x.x + v.x, x.y + v.y), kY));
        cst += abs(la - dot(real_bil(1, x.x, x.y), kY));
        mu += la; m2 += la * la;
      }
    float sd = sqrt(max(m2 / 9.0 - (mu / 9.0) * (mu / 9.0), 0.0));
    if (sd > 0.01 && !(cmv < 0.7 * cst)) return false;
  }
  return true;
}

void main() {
  int W = pc.a.x, H = pc.a.y;
  int bw = (W + 3) / 4, bh = (H + 3) / 4;
  ivec2 b = ivec2(gl_GlobalInvocationID.xy);
  if (b.x >= bw || b.y >= bh) return;
  int tw = (W + 15) / 16, th = (H + 15) / 16;
  ivec2 t = b / 4;
  uint any_flag = 0u;
  for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x) {
      ivec2 q = clamp(t + ivec2(x, y), ivec2(0), ivec2(tw - 1, th - 1));
      any_flag |= c_words[q.y * tw + q.x];
    }
  vec2 v = vec2(0.0);
  bool ok = any_flag != 0u && halo_decide(min(b * 4 + 1, ivec2(W - 1, H - 1)), W, H, v);
  uint i = uint(b.y * bw + b.x) * 3u;
  vrs[i] = v.x;
  vrs[i + 1u] = v.y;
  vrs[i + 2u] = ok ? 1.0 : 0.0;
}
