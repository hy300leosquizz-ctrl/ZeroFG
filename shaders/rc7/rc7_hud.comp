#version 450
#extension GL_GOOGLE_include_directive : require
// The screen: what repeats in place and has texture, unless the motion around it explains it as well (a flat inside repeats under both, a letter only in place). Counts what repeats among what has
// texture, for the host's rule that a scene mostly standing still has no overlay.
#include "rc7_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (q.x >= LW || q.y >= LH) return;
  int p = q.y * LW + q.x;
  plan[planOf(P_HUD, 0, p)] = 0.0;
  // The screen by cells (O_HUDCELL, review 12.4): persistence says which cells, the pixel says which part of the cell. For the rule
  // (rc7_hudrule.comp) this pass leaves, packed as px + 2 state: what this pair tells the cell's memory (state 2 a HUD, 1 not one, 0 not
  // looked at: the memory keeps what it had) and whether the cell's pixels take the screen one by one this pair (px).
  if (O_HUDCELL) plan[planOf(P_HUDMEM, 1, p)] = 0.0;
  float tx = stat[statOf(0, 0, p)];
  if (tx < u.th0.x) {
    if (O_HUDCELL) plan[planOf(P_HUDMEM, 1, p)] = 2.0;
    return;
  }
  atomicAdd(counter[0], 1u);
  vec2 pos = latCentre(q);
  float mean = 0.0;
  for (int b = -1; b <= 1; ++b)
    for (int a = -1; a <= 1; ++a) {
      vec2 t = pos + vec2(float(a), float(b)) * float(S);
      mean += l1(sampleReal(0, t), sampleReal(1, t));
    }
  mean /= 9.0;
  float here = l1(sampleReal(0, pos), sampleReal(1, pos));
  // What a wrong match would cost on the sharp picture.
  float d1 = max(1.0, 4.0 / float(S)) * float(S);
  vec3 c = sampleReal(0, pos);
  float wrong = 0.25 * (min(l1(c, sampleReal(0, pos + vec2(d1, 0.0))), 0.25) + min(l1(c, sampleReal(0, pos + vec2(0.0, d1))), 0.25) + min(l1(c, sampleReal(0, pos + vec2(d1, d1))), 0.25) + min(l1(c, sampleReal(0, pos + vec2(d1, -d1))), 0.25));
  bool exact = mean < max(0.004, min(0.02, 0.2 * wrong)) || (here < 0.006 && tx >= 0.05);
  // A HUD stays in place for hundreds of frames: what was the screen lately and still repeats in place, loosely, stays the screen, whatever runs behind it in this pair. P_HUD's second side holds the memory.
  bool remembered = u.cfg3.w > 0 && plan[planOf(P_HUD, 1, p)] > 0.25 && here < 0.08;
  // The cells' memory (O_HUDCELL) hands a remembered cell over pixel by pixel, never whole, and the pixel decides (rc7_render.comp,
  // screenPixel): what follows the motion stays the layers'. So it needs none of the tests above against a background glued to the screen,
  // which a cell where a thin HUD is a small part of a moving scene always fails.
  bool cell_memory = O_HUDCELL && plan[planOf(P_HUDMEM, 0, p)] > 0.25 && here < 0.08;
  // The cell's own pixels are read on one lattice point in sixteen per pair (O_HUDCELL; the memory adds the pairs up; one in four cost
  // 2.5 ms on the Adreno 840 over the 1536 x 1344 Katamari bars), or on every point
  // (layhudpx bit 1, the lab's whole-cell form).
  bool look = (R_OPTS & 131072) != 0 || (O_HUDCELL && (q.x & 3) + 4 * (q.y & 3) == pc.a.x);
  if (!exact && !remembered && !cell_memory && !look && u.th4.x <= 0.0) return;
  ivec2 cq = clamp(ivec2(pos / u.cell.xy), ivec2(0), ivec2(u.cfg2.x - 1, u.cfg2.y - 1));
  vec2 v = cells[cq.y * u.cfg2.x + cq.x].zw;
  float moved = -1.0;
  if (length(v) >= 1.0) {
    float sum = 0.0, n = 0.0;
    for (int b = -1; b <= 1; ++b)
      for (int a = -1; a <= 1; ++a) {
        vec2 t = pos + vec2(float(a), float(b)) * float(S), t2 = t + v;
        if (!insideM(t2)) continue;
        sum += l1(sampleReal(0, t), sampleReal(1, t2));
        n += 1.0;
      }
    if (n > 0.0) moved = sum / n;
  }
  // The tests above look at the lattice point and at a window of 3 x 3 points around it (8 px apart at 1280, and on a reduced copy of
  // the Reals from 800 wide). A letter's stroke or a thin line that passes between the points is not seen: on the lab's clean HUD the
  // overlay falls from 28 to 15 dB when the HUD sits half a cell off the lattice (hud_phase), and over a moving scene the window is mostly
  // what moves. This reads the cell's own pixels on the full-size Reals: a pixel that repeats in place, stands out from what is 3 px
  // away, and does not match where the motion around would have taken it, is on the screen; a stroke is such pixels that touch.
  bool thin = false;
  if (look && !exact) {
    // The cell and one pixel more on each far side, a row of bits per line: a stroke is pixels that touch, a coincidence in a noisy texture is a pixel alone
    // (three alone were enough in the lab's first form, and a plain moving ground lost 1.3 dB to them).
    int rows[9];
    int n = min(S, 8) + 1;
    ivec2 first = ivec2(pos) - ivec2(S / 2), top = ivec2(W - 1, H_ - 1);
    for (int b = 0; b < n; ++b) {
      int bits = 0;
      for (int a = 0; a < n; ++a) {
        ivec2 x = clamp(first + ivec2(a, b), ivec2(0), top);
        vec3 ca = texelFetch(cubicA, x, 0).rgb;
        if (l1(ca, texelFetch(cubicB, x, 0).rgb) >= 0.006) continue;
        float stands = max(max(l1(ca, texelFetch(cubicA, clamp(x + ivec2(3, 0), ivec2(0), top), 0).rgb), l1(ca, texelFetch(cubicA, clamp(x - ivec2(3, 0), ivec2(0), top), 0).rgb)),
                           max(l1(ca, texelFetch(cubicA, clamp(x + ivec2(0, 3), ivec2(0), top), 0).rgb), l1(ca, texelFetch(cubicA, clamp(x - ivec2(0, 3), ivec2(0), top), 0).rgb)));
        if (stands < 0.05) continue;
        ivec2 there = x + ivec2(round(v));
        if (length(v) >= 1.0 && all(greaterThanEqual(there, ivec2(0))) && all(lessThanEqual(there, top)) && l1(ca, texelFetch(cubicB, there, 0).rgb) < 0.05) continue;
        bits |= 1 << a;
      }
      rows[b] = bits;
    }
    int linked = 0;
    for (int b = 0; b < n; ++b) {
      linked += bitCount(rows[b] & (rows[b] >> 1));
      if (b + 1 < n) linked += bitCount(rows[b] & rows[b + 1]);
    }
    thin = linked >= 4;
  }
  // A translucent overlay: the background moves behind it, so it never repeats exactly, but it repeats in place better than it follows anything that moves. A flow that fails on a fast camera says
  // nothing, so the surfaces have the last word; the still one, always last, is what this is being compared with.
  bool translucent = u.th4.x > 0.0 && moved >= 0.0 && length(v) >= 2.0 && tx >= 0.02 && mean < u.th4.x * moved;
  for (int k = 0; translucent && k < PLANES - 1; ++k) {
    float c = cost[costOf(0, 0, k, p)];
    if (c >= 0.0 && mean >= u.th4.x * c) translucent = false;
  }
  // What is remembered must still repeat in place better than it follows the motion or a surface: a background learned while the camera rested follows them as soon as the pan begins, and glued to the screen it comes out as A and B mixed in place.
  if (remembered && moved >= 0.0 && moved <= mean) remembered = false;
  for (int k = 0; remembered && k < PLANES - 1; ++k) {
    float c = cost[costOf(0, 0, k, p)];
    if (c >= 0.0 && c <= mean) remembered = false;
  }
  // An exact repeat that the motion around explains as well is a flat inside, not the screen.
  bool explained = !remembered && exact && u.th3.y > 0.5 && moved >= 0.0 && moved < max(0.012, 2.0 * mean);
  bool whole = (exact || translucent || remembered || (thin && (R_OPTS & 131072) != 0)) && !explained;
  if (O_HUDCELL) {
    // A stroke teaches the memory but never takes the cell itself: a cell handed over whole mixes the scene around the stroke in place.
    int state = (exact && !explained) || thin ? 2 : look || exact ? 1 : 0;
    bool px = cell_memory && !whole;
    plan[planOf(P_HUDMEM, 1, p)] = (px ? 1.0 : 0.0) + 2.0 * float(state);
  }
  if (!whole) return;
  atomicAdd(counter[1], 1u);
  plan[planOf(P_HUD, 0, p)] = 1.0;
}
