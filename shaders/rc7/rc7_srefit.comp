#version 450
#extension GL_GOOGLE_include_directive : require
// The surfaces of the last pair, brought up to this pair's motion. Which surfaces there are changes slowly, and the search finds that in the background; how each one moves changes every pair, and this pair's flow says it.
// pc.a.x: 2 clear; 0 every cell in its own lane goes to the surface nearest to it and adds what it says; 1 every surface in its own lane solves a small affine correction after its model (the plane's perspective stays), then
// its inverse and the map from the middle. The still surface, the last one, never moves. Sums in fixed point, since lanes of different groups add to them.
#include "rc7_common.glsl"
#include "rc7_search.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

const float FIX_M = 65536.0, FIX_R = 16777216.0;

void main() {
  int mode = pc.a.x;
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  int moving = s_planes - 1;
  if (mode == 2) {
    int i = q.y * 8 + q.x;
    if (i < 72) r_sum[i] = 0;
    return;
  }
  if (mode == 0) {
    int fw = u.cfg2.x, fh = u.cfg2.y;
    if (q.x >= fw || q.y >= fh) return;
    vec2 scale = searchScale();
    vec2 pos = (vec2(q) + 0.5) * u.cell.xy;
    vec2 n = pos * scale - 1.0, to = (pos + cells[q.y * fw + q.x].xy) * scale - 1.0;
    float tol = 6.0 * max(1.0, float(W) / 640.0), best = tol * tol;
    int k_best = -1;
    vec2 p_best = vec2(0.0);
    for (int k = 0; k < 6; ++k) {
      if (k > moving) break;
      int t = k * 3;
      vec2 p = hApply(t_H[t], t_H[t + 1], t_H[t + 2], n);
      vec2 r = (to - p) / scale;
      float d = dot(r, r);
      if (d < best) {
        best = d;
        k_best = k;
        p_best = p;
      }
    }
    // The camera stopped (R_OPTS bit 21, mode 3): the cells nearest to the still surface and the cells whose own flow is under half a pixel,
    // in the still surface's own (otherwise unused) slots.
    if ((R_OPTS & 2097152) != 0) {
      if (k_best == moving) atomicAdd(r_sum[moving * 12 + 5], 1);
      const vec2 own = cells[q.y * fw + q.x].xy;
      if (dot(own, own) < 0.25) atomicAdd(r_sum[moving * 12 + 11], 1);
    }
    if (k_best < 0 || k_best == moving) return;
    float x = p_best.x, y = p_best.y;
    vec2 r = to - p_best;
    int o = k_best * 12;
    atomicAdd(r_sum[o], int(x * x * FIX_M));
    atomicAdd(r_sum[o + 1], int(x * y * FIX_M));
    atomicAdd(r_sum[o + 2], int(x * FIX_M));
    atomicAdd(r_sum[o + 3], int(y * y * FIX_M));
    atomicAdd(r_sum[o + 4], int(y * FIX_M));
    atomicAdd(r_sum[o + 5], 1);
    atomicAdd(r_sum[o + 6], int(r.x * x * FIX_R));
    atomicAdd(r_sum[o + 7], int(r.x * y * FIX_R));
    atomicAdd(r_sum[o + 8], int(r.x * FIX_R));
    atomicAdd(r_sum[o + 9], int(r.y * x * FIX_R));
    atomicAdd(r_sum[o + 10], int(r.y * y * FIX_R));
    atomicAdd(r_sum[o + 11], int(r.y * FIX_R));
    return;
  }
  if (mode == 3) {
    // The camera stopped (R_OPTS bit 21; lab laystale=2, JUDGE_DESIGN_2026-11 §8), one lane after mode 1. When the surface nearest to over
    // half of this pair's cells (and, if it is not the fallback, to over 1.5 times as many as the fallback: index 0, the biggest of the
    // last search, where a point without evidence goes) is within a pixel (x the width over 640) of still at the picture's corners, and
    // over half the cells' own flow is under half a pixel, the fallback holds still for the pair. Otherwise the last search's background,
    // now a sliver (rain, a cape), carries its motion to every point without evidence until the background search ends: Arkham 1 lost
    // 5-8.5 dB on the pairs after a pan stops. A slow pan is not a stop (God of War II), and only the fallback changes (swapping two moving
    // surfaces turned their layer order over). The fallback counts among the candidates, so once still it stays still.
    if (q.x != 0 || q.y != 0 || moving < 1) return;
    const float cells_n = float(u.cfg2.x * u.cfg2.y), n0 = float(r_sum[5]);
    int j = -1;
    float nj = 0.0;
    for (int k = 0; k <= moving && k < 6; ++k) {
      const float nk = float(r_sum[k * 12 + 5]);
      if (nk > nj) {
        nj = nk;
        j = k;
      }
    }
    if (j < 0 || nj <= 0.5 * cells_n || (j != 0 && nj <= 1.5 * n0)) return;
    if (float(r_sum[moving * 12 + 11]) <= 0.5 * cells_n) return;
    const vec2 scale = searchScale();
    float off = 0.0;
    for (int c = 0; c < 4; ++c) {
      const vec2 n = vec2((c & 1) != 0 ? 1.0 : -1.0, (c & 2) != 0 ? 1.0 : -1.0);
      off = max(off, length((hApply(r_H[j * 3], r_H[j * 3 + 1], r_H[j * 3 + 2], n) - n) / scale));
    }
    if (off > max(1.0, float(W) / 640.0)) return;
    for (int r = 0; r < 3; ++r) {
      const vec4 e = vec4(r == 0 ? 1.0 : 0.0, r == 1 ? 1.0 : 0.0, r == 2 ? 1.0 : 0.0, 0.0);
      r_H[r] = e;
      r_Hi[r] = e;
      r_Mid[r] = e;
    }
    return;
  }
  int k = q.y * 8 + q.x, t = k * 3;
  if (k >= 6) return;
  if (k >= moving) {
    if (k == moving) {
      for (int r = 0; r < 3; ++r) {
        r_H[t + r] = t_H[t + r];
        r_Hi[t + r] = t_H[t + r];
        r_Mid[t + r] = t_H[t + r];
      }
    }
    return;
  }
  int o = k * 12;
  float count = float(r_sum[o + 5]);
  vec3 a0 = vec3(0.0), a1 = vec3(0.0);
  if (count >= 16.0) {
    float xx = float(r_sum[o]) / FIX_M, xy = float(r_sum[o + 1]) / FIX_M, x = float(r_sum[o + 2]) / FIX_M, yy = float(r_sum[o + 3]) / FIX_M, y = float(r_sum[o + 4]) / FIX_M;
    vec3 ru = vec3(float(r_sum[o + 6]), float(r_sum[o + 7]), float(r_sum[o + 8])) / FIX_R, rv = vec3(float(r_sum[o + 9]), float(r_sum[o + 10]), float(r_sum[o + 11])) / FIX_R;
    mat3 m = mat3(xx, xy, x, xy, yy, y, x, y, count);
    float spread = (xx - x * x / count) * (yy - y * y / count) - (xy - x * y / count) * (xy - x * y / count);
    // Over a narrow patch only the shift is known.
    if (spread > 1e-4 * count * count) {
      mat3 inv = inverse(m);
      a0 = inv * ru;
      a1 = inv * rv;
    } else {
      a0 = vec3(0.0, 0.0, ru.z / count);
      a1 = vec3(0.0, 0.0, rv.z / count);
    }
  }
  vec3 r0 = t_H[t].xyz, r1 = t_H[t + 1].xyz, r2 = t_H[t + 2].xyz;
  mat3 h = transpose(mat3((1.0 + a0.x) * r0 + a0.y * r1 + a0.z * r2, a1.x * r0 + (1.0 + a1.y) * r1 + a1.z * r2, r2));
  mat3 hi = inverse(h);
  mat3 ym = h, z = mat3(1.0);
  for (int it = 0; it < 8; ++it) {
    mat3 iy = inverse(ym), iz = inverse(z);
    ym = 0.5 * (ym + iz);
    z = 0.5 * (z + iy);
  }
  mat3 ht = transpose(h), hit = transpose(hi), zt = transpose(z);
  for (int r = 0; r < 3; ++r) {
    r_H[t + r] = vec4(ht[r], 0.0);
    r_Hi[t + r] = vec4(hit[r], 0.0);
    r_Mid[t + r] = vec4(zt[r], 0.0);
  }
}
