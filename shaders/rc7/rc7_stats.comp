#version 450
#extension GL_GOOGLE_include_directive : require
// Per lattice point: how much texture, sharp (only the screen reads it, on picture A) and soft, and what a wrong match costs (the softened picture against itself a few pixels off). pc.a.x: the side.
#include "rc7_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

float grad(int side, bool soft, vec2 pos) {
  vec3 c = soft ? sampleSoft(side, pos) : sampleReal(side, pos);
  vec3 right = soft ? sampleSoft(side, pos + vec2(float(S), 0.0)) : sampleReal(side, pos + vec2(float(S), 0.0));
  vec3 down = soft ? sampleSoft(side, pos + vec2(0.0, float(S))) : sampleReal(side, pos + vec2(0.0, float(S)));
  vec3 d = abs(c - right) + abs(c - down);
  return (d.x + d.y + d.z) / 6.0;
}

void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (q.x >= LW || q.y >= LH) return;
  int side = THIS_SIDE, p = q.y * LW + q.x;
  vec2 pos = latCentre(q);
  const bool thin = (R_OPTS & 1024) != 0;
  const int samples = thin ? 8 : 16;
  if (side == 0) {
    float sharp = 0.0;
    for (int n = 0; n < samples; ++n) sharp += grad(side, false, pos + PATCH[thin ? THIN[n] : n] * float(S));
    stat[statOf(0, side, p)] = sharp / float(samples);
  }
  // A's soft statistics already came from the former B. This specialized
  // pipeline still makes A's sharp statistic as before.
  if ((REUSE_OPTS & 512) != 0 && THIS_KIND == 1) return;
  float soft = 0.0;
  for (int n = 0; n < samples; ++n) soft += grad(side, true, pos + PATCH[thin ? THIN[n] : n] * float(S));
  stat[statOf(1, side, p)] = soft / float(samples);
  float d1 = max(1.0, 4.0 / float(S)) * float(S), d2 = max(2.0, 7.0 / float(S)) * float(S);
  vec3 c = sampleSoft(side, pos);
  float sum = 0.0;
  const vec2 dirs[4] = vec2[4](vec2(1, 0), vec2(0, 1), vec2(1, 1), vec2(1, -1));
  for (int e = 0; e < 4; ++e) {
    sum += min(l1(c, sampleSoft(side, pos + dirs[e] * d1)), 0.25);
    sum += min(l1(c, sampleSoft(side, pos + dirs[e] * d2)), 0.25);
  }
  stat[statOf(2, side, p)] = sum / 8.0;
}
