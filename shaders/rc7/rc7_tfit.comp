#version 450
#extension GL_GOOGLE_include_directive : require
// A surface from the small picture's votes: a coarse vector makes a wild model out of three or four points, so each distinct vote is a plain translation; the best few, placed roughly, are judged on the pictures.
// pc.a.x: 0 enough left to try?; 1 the votes' scores, every block in its own lane; 2 the best four that differ; 3 each placed by two rounds, in its own lane; 4 the pictures' score, a sparse grid in its own lanes;
// 5 the winner starts the fit and the blocks become the sample; 6 which blocks it explains; 7 is it a surface at all.
#include "rc7_common.glsl"
#include "rc7_search.glsl"
#include "rc7_thumb.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

vec2 blockPos(int i) { return (vec2(float(i % t_bw), float(i / t_bw)) + 0.5) * float(BLOCK * t_step); }

void main() {
  int mode = pc.a.x;
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  if (mode == 0) {
    if (q != ivec2(0) || t_on == 0) return;
    if (t_unexplained * 100 < t_trusted * 25 || t_unexplained < 16) {
      t_on = 0;
      s_stop = 1;
    }
    t_ind_block = uvec4(0u);
    return;
  }
  if (t_on == 0 || s_stop != 0) return;
  int bw = t_bw, bh = t_bh, blocks = bw * bh;
  float grain = float(t_step);
  vec2 scale = searchScale();
  if (mode == 1) {
    if (q.x >= bw || q.y >= bh) return;
    int i = q.y * bw + q.x;
    vec4 me = t_cell[i];
    float score = -1.0;
    if (me.z > 0.5) {
      score = 0.0;
      for (int b = 0; b < blocks; ++b) {
        vec4 c = t_cell[b];
        if (c.z > 0.5 && dot(c.xy - me.xy, c.xy - me.xy) < grain * grain) score += 1.0;
      }
    }
    t_score[i] = score;
    return;
  }
  if (mode == 2) {
    if (q != ivec2(0)) return;
    vec2 chosen[4];
    int n = 0;
    for (int c = 0; c < 4; ++c) {
      int best = -1;
      float best_score = -0.5;
      for (int i = 0; i < blocks; ++i) {
        float s = t_score[i];
        if (s <= best_score) continue;
        bool same = false;
        for (int k = 0; k < n; ++k) same = same || length(t_cell[i].xy - chosen[k]) < 2.0;
        if (same) continue;
        best_score = s;
        best = i;
      }
      if (best < 0) break;
      chosen[n++] = t_cell[best].xy;
    }
    if (n == 0) {
      s_stop = 1;
      return;
    }
    for (int k = 0; k < 4; ++k) {
      vec2 v = k < n ? chosen[k] : vec2(1e6);
      t_cand[k * 3] = vec4(1.0, 0.0, v.x * scale.x, k < n ? 1.0 : 0.0);
      t_cand[k * 3 + 1] = vec4(0.0, 1.0, v.y * scale.y, 0.0);
      t_cand[k * 3 + 2] = vec4(0.0, 0.0, 1.0, 0.0);
      t_pic[k] = 0;
    }
    return;
  }
  if (mode == 3) {
    if (q.y != 0 || q.x >= 4) return;
    int c = q.x;
    vec4 r0 = vec4(t_cand[c * 3].xyz, 0.0), r1 = t_cand[c * 3 + 1];
    if (t_cand[c * 3].w > 0.5) {
      float ss = grain * 0.5;
      for (int round_i = 0; round_i < 2; ++round_i) {
        mat3 m = mat3(0.0);
        vec3 ru = vec3(0.0), rv = vec3(0.0);
        for (int i = 0; i < blocks; ++i) {
          vec4 b = t_cell[i];
          if (b.z < 0.5) continue;
          vec2 pos = blockPos(i), from = pos * scale - 1.0, to = (pos + b.xy) * scale - 1.0;
          vec3 p = vec3(from, 1.0);
          vec2 r = (vec2(dot(r0.xyz, p), dot(r1.xyz, p)) - to) / scale;
          float qq = length(r) / (12.0 * ss);
          if (qq >= 1.0) continue;
          float w = (1.0 - qq * qq) * (1.0 - qq * qq);
          m += w * outerProduct(p, p);
          ru += w * to.x * p;
          rv += w * to.y * p;
        }
        if (abs(determinant(m)) < 1e-6) break;
        mat3 inv = inverse(m);
        r0 = vec4(inv * ru, 0.0);
        r1 = vec4(inv * rv, 0.0);
      }
    }
    t_placed[c * 3] = r0;
    t_placed[c * 3 + 1] = r1;
    t_placed[c * 3 + 2] = vec4(0.0, 0.0, 1.0, 0.0);
    return;
  }
  if (mode == 4) {
    int step_px = max(8, W / 80);
    vec2 pos = (vec2(q) + 1.0) * float(step_px) + 0.5;
    if (pos.x + 1.0 >= float(W) || pos.y + 1.0 >= float(H_)) return;
    ivec2 cb = min(ivec2(pos / float(BLOCK * t_step)), ivec2(bw - 1, bh - 1));
    if (t_cell[cb.y * bw + cb.x].z < 0.5) return;
    float here = lumaOf(sampleReal(0, pos));
    float weight = min(0.25, abs(lumaOf(sampleReal(0, pos + vec2(1.0, 0.0))) - lumaOf(sampleReal(0, pos - vec2(1.0, 0.0)))) + abs(lumaOf(sampleReal(0, pos + vec2(0.0, 1.0))) - lumaOf(sampleReal(0, pos - vec2(0.0, 1.0)))));
    if (weight <= 0.0) return;
    vec2 n = pos * scale - 1.0;
    for (int c = 0; c < 4; ++c) {
      if (t_cand[c * 3].w < 0.5) continue;
      vec2 at = (hApply(t_placed[c * 3], t_placed[c * 3 + 1], t_placed[c * 3 + 2], n) + 1.0) / scale;
      if (!insideP(at)) continue;
      float miss = abs(here - lumaOf(sampleReal(1, at)));
      if (miss < 0.08) atomicAdd(t_pic[c], int(weight * (1.0 - miss / 0.08) * 1024.0));
    }
    return;
  }
  if (mode == 5) {
    if (q != ivec2(0)) return;
    int best = -1, best_pic = -1;
    for (int c = 0; c < 4; ++c)
      if (t_cand[c * 3].w > 0.5 && t_pic[c] > best_pic) {
        best_pic = t_pic[c];
        best = c;
      }
    if (best < 0) {
      s_stop = 1;
      return;
    }
    s_cur[0] = vec4(t_cand[best * 3].xyz, 0.0);
    s_cur[1] = t_cand[best * 3 + 1];
    s_cur[2] = t_cand[best * 3 + 2];
    s_cur_plane = 0;
    int got = 0;
    for (int i = 0; i < blocks && got < 256; ++i) {
      vec4 b = t_cell[i];
      if (b.z < 0.5) continue;
      vec2 pos = blockPos(i);
      s_sample[got++] = vec4(pos * scale - 1.0, (pos + b.xy) * scale - 1.0);
    }
    s_sample_n = got;
    t_count = 0;
    return;
  }
  if (mode == 6) {
    if (q.x >= bw || q.y >= bh) return;
    int i = q.y * bw + q.x;
    vec4 b = t_cell[i];
    if (b.z < 0.5) return;
    vec2 pos = blockPos(i);
    vec2 r = (hApply(s_cur[0], s_cur[1], s_cur[2], pos * scale - 1.0) + 1.0) / scale - pos - b.xy;
    if (dot(r, r) >= grain * grain) return;
    t_cell[i].z = 0.0;
    atomicOr(s_claim[i >> 5], 1u << (i & 31));
    atomicAdd(t_count, 1);
    return;
  }
  // Too few: the end. Much like one already found, or an echo of one: nothing to keep, the next try goes on with what is left.
  if (q != ivec2(0)) return;
  t_accept = 0;
  int count = t_count, least = max(16, t_trusted / 32);
  for (int w = 0; w < 128; ++w) s_claim[w] = 0u;
  bool add = count >= least;
  if (count < least) s_stop = 1;
  add = add && !alreadyKnown();
  for (int k = 0; k < 8; ++k) {
    s_detail[k] = 0;
    s_same[k] = 0;
  }
  t_accept = add ? 1 : 0;
}
